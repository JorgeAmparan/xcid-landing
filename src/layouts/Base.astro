---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  section?: 'inicio' | 'fact' | 'trabajo' | 'escritos' | 'contacto' | 'admin';
  sub?: string;
  lang?: string;
  ogType?: string;
}
const {
  title,
  description = 'Consultor y constructor de soluciones de IA para empresas. Infraestructura que sustenta el criterio profesional cuando la IA participa en formarlo. Corredor Juárez – El Paso.',
  section = 'inicio',
  sub,
  lang = 'es',
  ogType = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const subLabel = sub ?? (section === 'inicio' ? 'CoInteligencia Profesional' : `/ ${section}`);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/logo-xcid.svg" type="image/svg+xml" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="es_MX" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" type="application/rss+xml" title="XCID — Escritos" href="/escritos/feed.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,400&family=Source+Sans+3:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <div style="min-height:100vh;display:flex;flex-direction:column">
    <header class="site-header">
      <a href="/" class="brand" aria-label="XCID — inicio">
        <span class="mark">X</span>
        <span style="display:flex;flex-direction:column">
          <span class="name">XCID</span>
          <span class="sub">{subLabel}</span>
        </span>
      </a>
      <nav class="site-nav" aria-label="Principal">
        <a href="/fact" class={section === 'fact' ? 'active' : ''}>XCID FACT</a>
        <a href="/trabajo" class={section === 'trabajo' ? 'active' : ''}>Trabajo</a>
        <a href="/escritos" class={section === 'escritos' ? 'active' : ''}>Escritos</a>
        <a href="/contacto" class={section === 'contacto' ? 'contact active' : 'contact'}>Contacto</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <span>XCID · CoInteligencia Profesional · Hecho en Juárez · El Paso · {new Date().getFullYear()}</span>
      <span>Lappicero Studio · <a href="/verify">xcid.dev/verify</a> · <a href="/admin" rel="nofollow">Entrar</a></span>
    </footer>
  </div>
</body>
</html>
