---
import '../styles/global.css';
interface Props { title: string; area?: 'escritos' | 'plataformas' | 'proyectos' | 'series' | 'temas' | 'inicio' | 'solicitudes' }
const { title, area = 'escritos' } = Astro.props;

const user = Astro.locals.adminUser;

const nav = [
  ['CONTENIDO', [['escritos', 'Escritos', '/admin'], ['plataformas', 'Plataformas propias', '/admin/plataformas'], ['proyectos', 'Proyectos Lappicero', '/admin/proyectos']]],
  ['TAXONOMÍA', [['series', 'Series', '/admin/series'], ['temas', 'Temas', '/admin/temas']]],
  ['SITIO', [['inicio', 'Página de inicio', '/admin/inicio'], ['solicitudes', 'Solicitudes', '/admin/solicitudes']]],
] as const;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title} · Panel XCID</title>
  <link rel="icon" href="/logo-xcid.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Source+Sans+3:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    .adm-head { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px 24px; padding:14px 28px; border-bottom:1px solid var(--ink); background:var(--paper); }
    .adm-side { flex:0 0 220px; border-right:1px solid var(--line); padding:18px 12px; display:flex; flex-direction:column; gap:2px; }
    .adm-side a { display:block; padding:9px 14px; color:var(--ink-soft); font-size:14.5px; font-weight:500; }
    .adm-side a:hover { color:var(--ink); background:var(--paper); }
    .adm-side a.on { background:var(--ink); color:var(--paper); }
    .adm-side .h { padding:14px 14px 8px; font-family:var(--mono); font-size:11px; letter-spacing:.12em; color:var(--ink-muted); }
    .adm-main { flex:999 1 560px; min-width:0; padding:26px 28px 56px; display:flex; flex-direction:column; gap:22px; }
    @media (max-width: 800px) { .adm-side { flex-basis:100%; border-right:0; border-bottom:1px solid var(--line); flex-direction:row; flex-wrap:wrap; } .adm-side .h { width:100%; padding-top:6px; } }
  </style>
</head>
<body>
  <div style="min-height:100vh;display:flex;flex-direction:column">
    <header class="adm-head">
      <a href="/admin" class="brand"><span class="mark">X</span><span style="display:flex;flex-direction:column"><span class="name">XCID</span><span class="sub">/ panel</span></span></a>
      <div class="mono" style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;font-size:12px;color:var(--ink-soft)">
        <span>{user?.email}</span>
        <a href="/" class="btn sm" style="font-size:12px">Ver sitio →</a>
        <form method="post" action="/api/auth/logout" style="margin:0"><button class="btn sm" style="font-size:12px;border-color:var(--line);color:var(--ink-soft)">Salir</button></form>
      </div>
    </header>
    <div style="display:flex;flex-wrap:wrap;flex:1">
      <nav class="adm-side" aria-label="Panel">
        {nav.map(([h, items]) => (<>
          <span class="h">{h}</span>
          {items.map(([k, label, href]) => <a href={href} class={area === k ? 'on' : ''}>{label}</a>)}
        </>))}
      </nav>
      <main class="adm-main"><slot /></main>
    </div>
  </div>
</body>
</html>
