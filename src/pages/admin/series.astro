---
import Admin from '../../layouts/Admin.astro';
import { currentAdmin } from '../../lib/supabase';
import { slugify } from '../../lib/md';
const T = 'series';
const { sb, isAdmin } = await currentAdmin(Astro.request, Astro.cookies);
if (!isAdmin || !sb) return Astro.redirect('/admin/login');
let error = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData(); const action = String(f.get('_action'));
  if (action === 'borrar') { const { error: err } = await sb.from(T).delete().eq('slug', String(f.get('slug'))); if (err) error = err.message; }
  else {
    const nombre = String(f.get('nombre') ?? '').trim();
    const row: any = { slug: slugify(String(f.get('slug') ?? '')) || slugify(nombre), nombre };
    if (T === 'series') { row.descripcion = String(f.get('descripcion') ?? '').trim() || null; row.orden = Number(f.get('orden')) || 0; }
    if (!nombre) error = 'Nombre obligatorio.'; else { const { error: err } = await sb.from(T).upsert(row, { onConflict: 'slug' }); if (err) error = err.message; }
  }
}
const { data: list } = await sb.from(T).select('*').order(T === 'series' ? 'orden' : 'nombre');
---
<Admin title="Series" area={T as any}>
  <h1 style="font-size:28px">Series</h1>
  {error && <p class="notice err">{error}</p>}
  <div class="grid12" style="gap:22px">
    <div style="grid-column:span 7" class="scroll-x"><table class="data">
      <thead><tr><th>NOMBRE</th><th>IDENTIFICADOR</th>{T === 'series' && <th>ORDEN</th>}<th></th></tr></thead>
      <tbody>{(list ?? []).map((r: any) => (
        <tr><td style="font-weight:600">{r.nombre}{r.descripcion && <><br /><span style="font-size:13px;color:var(--ink-muted);font-weight:400">{r.descripcion}</span></>}</td><td class="mono" style="font-size:12px">{r.slug}</td>{T === 'series' && <td class="mono" style="font-size:12px">{r.orden}</td>}
          <td style="text-align:right"><form method="post" style="margin:0"><input type="hidden" name="slug" value={r.slug} /><button class="btn sm" name="_action" value="borrar" style="font-size:12px;color:var(--accent);border-color:var(--line)" onclick="return confirm('¿Eliminar? Los escritos que lo usan lo conservan como texto.')">Eliminar</button></form></td></tr>
      ))}</tbody>
    </table></div>
    <form method="post" class="panel" style="grid-column:span 5;padding:20px;display:flex;flex-direction:column;gap:14px">
      <span class="section-no" style="letter-spacing:.12em">AGREGAR O EDITAR</span>
      <div><label class="lbl" for="nombre">Nombre</label><input class="fld" id="nombre" name="nombre" required /></div>
      <div><label class="lbl" for="slug">Identificador (vacío = del nombre)</label><input class="fld mono" id="slug" name="slug" style="font-size:13px" /></div>
      {T === 'series' && <><div><label class="lbl" for="descripcion">Descripción</label><input class="fld" id="descripcion" name="descripcion" /></div><div><label class="lbl" for="orden">Orden</label><input class="fld mono" id="orden" name="orden" type="number" value="0" style="font-size:13px" /></div></>}
      <button class="btn accent sm" name="_action" value="guardar">Guardar</button>
    </form>
  </div>
</Admin>
