---
import '../../styles/global.css';
import { serverClient, hasSupabase, ADMIN_EMAILS, SITE_URL } from '../../lib/supabase';

let sent = false; let error = '';
if (Astro.url.searchParams.get('e') === 'noadmin') error = 'Esa cuenta no tiene acceso al panel.';
if (Astro.url.searchParams.get('e') === 'link') error = 'El enlace no es válido o expiró. Pide uno nuevo.';

if (Astro.request.method === 'POST' && hasSupabase) {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  if (!ADMIN_EMAILS.includes(email)) {
    error = 'Ese correo no está autorizado.';
  } else {
    const sb = serverClient(Astro.request, Astro.cookies)!;
    const { error: err } = await sb.auth.signInWithOtp({ email, options: { emailRedirectTo: `${SITE_URL}/api/auth/callback` } });
    if (err) error = err.message; else sent = true;
  }
}
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Entrar · Panel XCID</title>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500&family=Source+Sans+3:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet" /></head>
<body>
<main style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">
  <form method="post" class="panel" style="width:100%;max-width:420px;padding:36px;display:flex;flex-direction:column;gap:18px">
    <div class="brand"><span class="mark">X</span><span style="display:flex;flex-direction:column"><span class="name">XCID</span><span class="sub">/ panel</span></span></div>
    <h1 style="font-size:26px">Entrar</h1>
    {!hasSupabase && <p class="notice err">Supabase no está configurado en este despliegue.</p>}
    {sent ? (
      <p class="notice">Te envié un enlace de acceso al correo. Ábrelo desde este mismo navegador.</p>
    ) : (<>
      <p style="margin:0;font-size:14.5px;color:var(--ink-soft)">Sin contraseña: te llega un enlace de un solo uso por correo.</p>
      {error && <p class="notice err">{error}</p>}
      <div><label class="lbl" for="email">Correo</label><input class="fld" id="email" name="email" type="email" required autocomplete="email" /></div>
      <button class="btn primary" type="submit" disabled={!hasSupabase}>Enviar enlace</button>
    </>)}
    <a href="/" class="mono" style="font-size:12px;color:var(--ink-muted)">← Volver al sitio</a>
  </form>
</main>
</body></html>
