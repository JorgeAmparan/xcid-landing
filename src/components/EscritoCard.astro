---
import type { Escrito } from '../lib/content';
import { fmtFecha } from '../lib/content';
interface Props { e: Escrito; series: Record<string, string> }
const { e, series } = Astro.props;
const serieNombre = series[e.serie] ?? e.serie;
const tipo = e.idioma === 'en' ? (e.tipo === 'comentario' ? 'commentary' : 'essay') : e.tipo;
---
<a href={`/escritos/${e.slug}`} style="display:flex;flex-direction:column;gap:10px;padding-top:20px;border-top:1px solid var(--ink)">
  <span class="mono" style={`font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:${e.serie === 'roce' ? 'var(--accent)' : 'var(--ink-muted)'}`}>
    {serieNombre} · {tipo} · {e.fecha.slice(0, 7)}
  </span>
  <span style="font-family:var(--serif);font-size:23px;font-weight:500;line-height:1.25">{e.titulo}</span>
  {e.bajada && <span style="font-size:15px;color:var(--ink-soft);line-height:1.5">{e.bajada}</span>}
</a>
